# Server-side only. Never commit the real .env file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional site metadata sent to OpenRouter.
SITE_URL=http://localhost:3000

# ChromaDB and local embeddings.
CHROMA_PERSIST_DIRECTORY=rag/chroma_data
CHROMA_COLLECTION=portfolio-content
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_RAG_API_URL=http://127.0.0.1:8000
